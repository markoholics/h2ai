{
  "version": 2,
  "builds": [
    { "src": "api/**/*.js",                                          "use": "@vercel/node" },
    { "src": "index.html",                                           "use": "@vercel/static" },
    { "src": "blog/index.html",                                      "use": "@vercel/static" },
    { "src": "blog/images/agentic-ai-search-thumbnail.png",          "use": "@vercel/static" },
    { "src": "blog/images/h2ai-framework-thumbnail.png",             "use": "@vercel/static" },
    { "src": "blog/how-to-adapt-to-googles-agentic-ai-search-brand-playbook/index.html", "use": "@vercel/static" },
    { "src": "blog/h2ai-framework-why-human-x-ai-beats-human-plus-ai/index.html",        "use": "@vercel/static" },
    { "src": "blog/google-ads-agentic-ai-era-search/index.html",                        "use": "@vercel/static" },
    { "src": "blog/synthetic-chokehold-how-to-build-owned-audience-agentic-era/index.html", "use": "@vercel/static" },
    { "src": "photo.jpg",                                            "use": "@vercel/static" },
    { "src": "photo.jpeg",                                           "use": "@vercel/static" },
    { "src": "logo.png",                                             "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1.js" },
    { "src": "/photo.jpg",  "dest": "/photo.jpg" },
    { "src": "/photo.jpeg", "dest": "/photo.jpeg" },
    { "src": "/logo.png",   "dest": "/logo.png" },
    { "src": "/blog/images/agentic-ai-search-thumbnail.png", "dest": "/blog/images/agentic-ai-search-thumbnail.png" },
    { "src": "/blog/images/h2ai-framework-thumbnail.png",    "dest": "/blog/images/h2ai-framework-thumbnail.png" },
    { "src": "/blog/how-to-adapt-to-googles-agentic-ai-search-brand-playbook", "dest": "/blog/how-to-adapt-to-googles-agentic-ai-search-brand-playbook/index.html" },
    { "src": "/blog/how-to-adapt-to-googles-agentic-ai-search-brand-playbook/", "dest": "/blog/how-to-adapt-to-googles-agentic-ai-search-brand-playbook/index.html" },
    { "src": "/blog/h2ai-framework-why-human-x-ai-beats-human-plus-ai",  "dest": "/blog/h2ai-framework-why-human-x-ai-beats-human-plus-ai/index.html" },
    { "src": "/blog/h2ai-framework-why-human-x-ai-beats-human-plus-ai/", "dest": "/blog/h2ai-framework-why-human-x-ai-beats-human-plus-ai/index.html" },
    { "src": "/blog/google-ads-agentic-ai-era-search",  "dest": "/blog/google-ads-agentic-ai-era-search/index.html" },
    { "src": "/blog/google-ads-agentic-ai-era-search/", "dest": "/blog/google-ads-agentic-ai-era-search/index.html" },
    { "src": "/blog/synthetic-chokehold-how-to-build-owned-audience-agentic-era",  "dest": "/blog/synthetic-chokehold-how-to-build-owned-audience-agentic-era/index.html" },
    { "src": "/blog/synthetic-chokehold-how-to-build-owned-audience-agentic-era/", "dest": "/blog/synthetic-chokehold-how-to-build-owned-audience-agentic-era/index.html" },
    { "src": "/blog",  "dest": "/blog/index.html" },
    { "src": "/blog/", "dest": "/blog/index.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
